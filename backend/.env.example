# --- Django ------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- LLM ---------------------------------------------------------------------
# 100 % local with Ollama + Gemma 4 E4B (tool calling). `ollama pull gemma4:e4b`
LLM_CHAT_MODEL=gemma4:e4b
# Gemma 4 "thinking" mode: false = much faster answers
LLM_THINK=false

# Embeddings for the RAG (Ollama)
OLLAMA_URL=http://localhost:11434
LLM_EMBED_MODEL=nomic-embed-text
LLM_NUM_CTX=8192
LLM_TIMEOUT=300
AGENT_MAX_HISTORY=16

# --- RAG ---------------------------------------------------------------------
RAG_TOP_K=4
RAG_MIN_SCORE=0.35

# --- Admissions service (shown when an answer is not in the document) ---------
ADMISSIONS_CONTACT_EMAIL=admissions@example.com
ADMISSIONS_CONTACT_PHONE=

# --- E-mails -----------------------------------------------------------------
ADMISSIONS_TEAM_EMAILS=equipe.admissions@example.com
DEFAULT_FROM_EMAIL=Assistant Admissions <no-reply@example.com>
SEND_PROSPECT_CONFIRMATION_EMAIL=True
# file = e-mails written to backend/sent_emails/ (demo) | console | smtp
EMAIL_MODE=file
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
