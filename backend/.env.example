# --- Django ------------------------------------------------------------------
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:4200

# --- LLM ---------------------------------------------------------------------
# Option A — Groq (cloud, fast, works on any PC). Free API key: https://console.groq.com/keys
LLM_PROVIDER=openai
LLM_API_URL=https://api.groq.com/openai/v1
LLM_API_KEY=gsk_votre_cle_ici
LLM_CHAT_MODEL=openai/gpt-oss-120b
LLM_THINK=
LLM_REASONING_EFFORT=low

# Option B — Ollama (100 % local). Needs a GPU with enough VRAM to be fast.
# LLM_PROVIDER=ollama
# LLM_CHAT_MODEL=qwen3:4b
# LLM_THINK=false

# Embeddings for the RAG always use Ollama (small model, fine on any PC)
OLLAMA_URL=http://localhost:11434
LLM_EMBED_MODEL=nomic-embed-text
LLM_NUM_CTX=4096
LLM_TIMEOUT=300
AGENT_MAX_HISTORY=16

# --- RAG ---------------------------------------------------------------------
RAG_TOP_K=4
RAG_MIN_SCORE=0.35

# --- Admissions service (shown when an answer is not in the document) ---------
ADMISSIONS_CONTACT_EMAIL=admissions@example.com
ADMISSIONS_CONTACT_PHONE=

# --- E-mails -----------------------------------------------------------------
ADMISSIONS_TEAM_EMAILS=equipe.admissions@example.com
DEFAULT_FROM_EMAIL=Assistant Admissions <no-reply@example.com>
SEND_PROSPECT_CONFIRMATION_EMAIL=True
# file = e-mails written to backend/sent_emails/ (demo) | console | smtp
EMAIL_MODE=file
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
